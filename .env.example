# =============================================================
#  MiraCosta Monitor - environment variables
# =============================================================
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values below.
#  3. NEVER commit .env  (it is already listed in .gitignore)
# =============================================================

# --- LINE Messaging API (required) ------------------------------------------
# LINE Developers Console > your Messaging API channel > "Messaging API" tab
# > "Channel access token (long-lived)" > Issue
LINE_CHANNEL_ACCESS_TOKEN=


# --- Who gets the notifications ---------------------------------------------
# Choose ONE of the two options below.
#
# OPTION A (recommended when more than one person should be notified):
#   Send to EVERYONE who has added this bot as a friend.
#   No user IDs needed at all - your friend just scans the bot's QR code.
#   This is the only way to reach someone else without running a webhook
#   server, because a friend's user ID is never shown in the LINE console.
#
#   Careful: anyone who adds the bot will receive the alerts, so do not
#   share the QR code publicly.
#
# LINE_BROADCAST=1
#
#
# OPTION B: send to a fixed list of IDs (comma separated).
#   - Your own user ID: LINE Developers Console > "Basic settings" tab
#     > "Your user ID". It starts with "U" + 32 hex characters.
#   - A friend's user ID CANNOT be found in the console. If you need one,
#     you must run a webhook server and read it from the "follow" event.
#     For a personal tool, use OPTION A instead.
#   - A group chat ID starts with "C", a multi-person chat ID with "R".
#     These also only arrive via webhook events.
#
#   Examples:
#     LINE_TO=U0123456789abcdef0123456789abcdef
#     LINE_TO=U0123456789abcdef0123456789abcdef,Ufedcba9876543210fedcba9876543210
LINE_TO=

# (LINE_USER_ID is the old name for LINE_TO and still works.)
# LINE_USER_ID=


# --- Optional: everything below has a safe default -------------------------

# Log verbosity: debug | info | warn | error   (default: info)
# LOG_LEVEL=info

# Override the config file location (default: config/watch.json)
# WATCH_CONFIG=config/watch.json

# Set to 1 to never actually send LINE messages (same as --dry-run)
# DRY_RUN=0
