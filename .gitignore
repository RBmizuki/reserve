# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
cookies.json
session.json

# ---- runtime data (may contain personal / site data) ----
data/
logs/
debug/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# ---- your personal watch conditions (keep the example tracked) ----
config/watch.json

# ---- build / deps ----
node_modules/
dist/
*.tsbuildinfo

# ---- generated launchd plist (contains machine-specific absolute paths) ----
launchd/*.plist
!launchd/*.plist.template

# ---- captures from the live site (npm run capture) ----
# Sanitised, but still real page content: keep them local unless you
# deliberately want one as a committed test fixture.
tests/fixtures/captured-*

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
